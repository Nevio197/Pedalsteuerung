{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pedalsteuerung 2",
  "version": "2.1.0",
  "identifier": "de.nevio.pedalsteuerung.v2",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Pedalsteuerung 2",
      "width": 1180,
      "height": 800,
      "minWidth": 900,
      "minHeight": 660,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCM0Q0REZDMzdGQUVGREYKUldUZjcvbzMvRTA5dTZoWGFCMzRTOUFlazhUUWxVNTJIYStOclIxUGg3VU5oSmVaeVk0bzRJdnIK",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/Nevio197/Pedalsteuerung/releases/latest/download/latest.json"]
    }
  }
}
